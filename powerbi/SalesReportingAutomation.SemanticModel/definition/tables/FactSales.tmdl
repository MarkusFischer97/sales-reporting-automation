table FactSales
	lineageTag: 1207ebbe-923b-4d63-bbc7-e851b3005c05

	measure 'Total Revenue' =
			
			SUM(FactSales[Revenue])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: e72b5c44-ee1d-48ba-b5dd-93a0c9d37b4b

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Total Cost' =
			
			SUM(FactSales[Cost])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 628b31e4-867c-4c3d-a7b0-693e4939f000

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Gross Profit' =
			
			[Total Revenue] - [Total Cost]
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: e89bbf4c-80ea-4d2a-bac0-8f56ef1de0d2

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Gross Margin %' =
			
			DIVIDE([Gross Profit], [Total Revenue])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 0047a68f-5484-470f-8395-404f356d7b2e

	measure 'Order Count' =
			
			DISTINCTCOUNT(FactSales[OrderID])
		formatString: 0
		lineageTag: b27eaaea-ca4a-4be3-bf46-4f2546a37f51

	measure 'Average Order Value' =
			
			DIVIDE([Total Revenue], [Order Count])
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: ecb1977d-634e-4ccb-b86f-d68bbbfc8d64

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Budget Revenue' =
			
			SUM(Budget[BudgetRevenue])
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: d0e7a02e-98c7-4a78-9f04-389becf82ff3

	measure 'Revenue Variance' =
			
			[Total Revenue] - [Budget Revenue]
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: a8a67469-47b3-4405-80ee-cd7cb1ef5b82

		annotation PBI_FormatHint = {"currencyCulture":"de-DE"}

	measure 'Revenue Variance %' =
			
			DIVIDE([Revenue Variance], [Budget Revenue])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 326b40b2-5316-451c-9912-cd750ee7df26

	measure 'Customer Count' =
			
			DISTINCTCOUNT(DimCustomer[CustomerID])
		formatString: 0
		lineageTag: 4c0a777c-c740-493d-bd6f-7eadb12b65ae

