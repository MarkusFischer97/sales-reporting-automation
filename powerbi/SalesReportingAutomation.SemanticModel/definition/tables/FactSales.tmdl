	column GrossProfit
		dataType: double
		lineageTag: 4cdf711b-431d-4cfe-86b9-6890286f0347
		summarizeBy: sum
		sourceColumn: GrossProfit

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition FactSales = m
		mode: import
		source =
				let
				    Source = Folder.Files("C:\Users\marku\Projects\github\sales-reporting-automation\data\raw\sales"),
				    ExcelFiles = Table.SelectRows(Source, each [Extension] = ".xlsx" and not Text.StartsWith([Name], "~$")),
				    AddWorkbook = Table.AddColumn(ExcelFiles, "Workbook", each Excel.Workbook([Content], null, true)),
				    ExpandWorkbook = Table.ExpandTableColumn(AddWorkbook, "Workbook", {"Name", "Data", "Kind"}, {"SheetName", "Data", "Kind"}),
				    SheetsOnly = Table.SelectRows(ExpandWorkbook, each [Kind] = "Sheet"),
				    AddPromoted = Table.AddColumn(SheetsOnly, "Promoted", each Table.PromoteHeaders([Data], [PromoteAllScalars = true])),
				    AddStandardized = Table.AddColumn(
				        AddPromoted,
				        "Standardized",
				        each Table.RenameColumns(
				            [Promoted],
				            {
				                {"Order Date", "OrderDate"},
				                {"Customer ID", "CustomerID"},
				                {"Product ID", "ProductID"},
				                {"Qty", "Quantity"},
				                {"Sales", "Revenue"}
				            },
				            MissingField.Ignore
				        )
				    ),
				    Combined = Table.Combine(AddStandardized[Standardized]),
				    SelectedColumns = Table.SelectColumns(
				        Combined,
				        {"OrderID", "OrderDate", "CustomerID", "ProductID", "Region", "Quantity", "Revenue", "Cost"},
				        MissingField.UseNull
				    ),
				    CleanText = Table.TransformColumns(
				        SelectedColumns,
				        {
				            {"OrderID", each if _ = null then null else Text.Trim(Text.From(_)), type text},
				            {"CustomerID", each if _ = null then null else Text.Trim(Text.From(_)), type text},
				            {"ProductID", each if _ = null then null else Text.Trim(Text.From(_)), type text},
				            {"Region", each if _ = null then null else Text.Proper(Text.Trim(Text.From(_))), type text}
				        }
				    ),
				    Typed = Table.TransformColumnTypes(
				        CleanText,
				        {
				            {"OrderID", type text}, {"OrderDate", type date}, {"CustomerID", type text},
				            {"ProductID", type text}, {"Region", type text}, {"Quantity", Int64.Type},
				            {"Revenue", type number}, {"Cost", type number}
				        }
				    ),
				    ValidRows = Table.SelectRows(
				        Typed,
				        each [OrderID] <> null and [CustomerID] <> null and [ProductID] <> null
				            and [OrderDate] <> null and [Quantity] <> null and [Revenue] <> null and [Cost] <> null
				    ),
				    Deduplicated = Table.Distinct(ValidRows, {"OrderID"}),
				    AddGrossProfit = Table.AddColumn(Deduplicated, "GrossProfit", each [Revenue] - [Cost], type number)
				in
				    AddGrossProfit

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

